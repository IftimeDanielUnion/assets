// This query creates only an in-memory test table; it does not ingest any log.
// Expected: two rows, ServiceName=ump-test; SeverityText=error or FATAL.
datatable(TimeGenerated:datetime, ServiceName:string, SeverityText:string)
[
    datetime(2026-10-01T08:00:00Z), "ump-test", "error",
    datetime(2026-10-01T08:00:01Z), "ump-test", "FATAL",
    datetime(2026-10-01T08:00:02Z), "ump-test", "warning",
    datetime(2026-10-01T08:00:03Z), "ump-test", "info"
]
| where SeverityText in~ ("error", "fatal")
| project TimeGenerated, ServiceName, SeverityText

--- a/live/dev/terragrunt.stack.hcl
+++ b/live/dev/terragrunt.stack.hcl
@@ -238,6 +238,46 @@
     prefix                       = local.prefix
     resource_group_name          = local.rg_moni_name
     tags                         = local.tags
+
+    # DBI-6455: Mail alerts for the existing OpenTelemetry log pipeline.
+    action_groups = {
+      osc-errors = {
+        short_name = "ump-${local.environment}"
+        email_receiver = [{
+          name                    = "osc-ui-team"
+          email_address           = "ui-team@os-cillation.de"
+          use_common_alert_schema = true
+        }]
+      }
+    }
+
+    scheduled_log_alerts = {
+      osc-errors = {
+        name                 = "ump-${local.environment}-otel-error-fatal"
+        description          = "DBI-6455: OpenTelemetry error/fatal records, grouped by ServiceName."
+        action_group_map_key = "osc-errors"
+        enabled              = true
+        evaluation_frequency = "PT1M"
+        severity             = 1
+        window_duration      = "PT5M"
+        criteria = [{
+          operator                = "GreaterThan"
+          threshold               = 0
+          time_aggregation_method = "Count"
+          query                   = <<-QUERY
+            OTelLogs
+            | where SeverityText in~ ("error", "fatal")
+            | extend ServiceName = iff(isempty(ServiceName), "unknown-service", ServiceName)
+            | project TimeGenerated, ServiceName
+          QUERY
+          dimension = [{
+            name     = "ServiceName"
+            operator = "Include"
+            values   = ["*"]
+          }]
+        }]
+      }
+    }
 
     dependencies_paths = ["../resourcegroup-monitor"]
   }
